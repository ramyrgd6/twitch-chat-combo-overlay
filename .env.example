# Required: your Twitch channel name, without the # symbol.
TWITCH_CHANNEL=your_channel_name

# Optional: leave blank for anonymous, read-only connection.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

PORT=3000

# Keep the local Control Room/OBS overlay private to this computer.
HOST=127.0.0.1
COMBO_TIMEOUT_MS=6500
MIN_COMBO_COUNT=2
